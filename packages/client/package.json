{
  "name": "@github-compass/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHubCompass — GitHub 访问守护：hosts 智能写入、本地探测选优、闭环自动切换",
  "author": "amyaxy",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "selftest": "tsx scripts/selftest-hosts-writer.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.amyaxy.githubcompass",
    "productName": "GitHubCompass",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/icon.ico",
      "resources/icon.png",
      "resources/tray.png",
      "resources/candidates.snapshot.json",
      "!node_modules/**"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GitHubCompass-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "resources/icon.png",
      "artifactName": "GitHubCompass-${version}-${arch}.${ext}"
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "@github-compass/core": "workspace:*",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.1.0",
    "vue": "^3.5.43"
  }
}
